{
  "id": "vn.zsoft.plugin.catalog",
  "name": "Product Catalog",
  "version": "0.1.0",
  "description": "A worked example of a PUBLIC, filterable plugin: its own products table, admin CRUD screens, and a public `catalog.search` query a theme can filter live (search, category, price, in-stock) with no page reload. The reference for the plugin-query pattern.",
  "author": {
    "name": "Z-SOFT Co., Ltd",
    "url": "https://z-soft.com.vn"
  },
  "engine": ">=0.1.0",
  "entry": "dist/index.js",
  "scope": "site",
  "permissions": ["data:own"],
  "capabilities": ["catalog.search"],
  "permissionsProvided": [
    { "key": "catalog:read", "description": "See the product catalog.", "defaultRoles": ["EDITOR", "ADMIN", "OWNER"] },
    { "key": "catalog:manage", "description": "Add, edit and remove products.", "defaultRoles": ["ADMIN", "OWNER"] }
  ],
  "database": {
    "tables": [
      {
        "name": "p_vn_zsoft_plugin_catalog__products",
        "columns": [
          { "name": "name", "type": "text" },
          { "name": "slug", "type": "text" },
          { "name": "category", "type": "text", "default": "skincare" },
          { "name": "cost", "type": "numeric", "nullable": true },
          { "name": "price", "type": "numeric", "default": 0 },
          { "name": "sale_price", "type": "numeric", "nullable": true },
          { "name": "discount_percent", "type": "numeric", "nullable": true },
          { "name": "in_stock", "type": "boolean", "default": true },
          { "name": "featured", "type": "boolean", "default": false },
          { "name": "image", "type": "uuid", "nullable": true },
          { "name": "description", "type": "text", "nullable": true }
        ],
        "indexes": [
          { "columns": ["slug"], "unique": true },
          { "columns": ["category"] }
        ]
      }
    ]
  },
  "admin": {
    "nav": [
      {
        "label": { "en": "Catalog", "vi": "Danh mục", "ja": "カタログ" },
        "icon": "shopping-bag",
        "resource": "products",
        "permission": "catalog:read"
      }
    ],
    "resources": [
      {
        "key": "products",
        "label": { "en": "Products", "vi": "Sản phẩm", "ja": "商品" },
        "table": "p_vn_zsoft_plugin_catalog__products",
        "list": {
          "columns": [
            { "column": "name", "label": { "en": "Name", "vi": "Tên", "ja": "名前" } },
            { "column": "category", "label": { "en": "Category", "vi": "Danh mục", "ja": "カテゴリ" } },
            { "column": "price", "label": { "en": "Price", "vi": "Giá", "ja": "価格" } },
            { "column": "in_stock", "label": { "en": "In stock", "vi": "Còn hàng", "ja": "在庫" } }
          ],
          "orderBy": { "column": "name", "direction": "asc" }
        },
        "form": {
          "fields": [
            { "column": "name", "label": { "en": "Name", "vi": "Tên", "ja": "名前" } },
            { "column": "slug", "label": { "en": "Slug", "vi": "Đường dẫn", "ja": "スラッグ" } },
            {
              "column": "category",
              "label": { "en": "Category", "vi": "Danh mục", "ja": "カテゴリ" },
              "input": "select",
              "options": [
                { "value": "skincare", "label": { "en": "Skincare", "vi": "Chăm sóc da", "ja": "スキンケア" } },
                { "value": "makeup", "label": { "en": "Makeup", "vi": "Trang điểm", "ja": "メイク" } },
                { "value": "fragrance", "label": { "en": "Fragrance", "vi": "Nước hoa", "ja": "フレグランス" } },
                { "value": "body", "label": { "en": "Body", "vi": "Cơ thể", "ja": "ボディ" } }
              ]
            },
            { "column": "cost", "label": { "en": "Cost price", "vi": "Giá nhập", "ja": "仕入れ値" }, "input": "number" },
            { "column": "price", "label": { "en": "Sale price", "vi": "Giá bán", "ja": "販売価格" }, "input": "number" },
            { "column": "sale_price", "label": { "en": "Promo price", "vi": "Giá khuyến mãi", "ja": "セール価格" }, "input": "number" },
            { "column": "discount_percent", "label": { "en": "Discount %", "vi": "Giảm giá %", "ja": "割引率 %" }, "input": "number" },
            { "column": "in_stock", "label": { "en": "In stock", "vi": "Còn hàng", "ja": "在庫あり" }, "input": "boolean" },
            { "column": "featured", "label": { "en": "Featured", "vi": "Nổi bật", "ja": "おすすめ" }, "input": "boolean" },
            { "column": "image", "label": { "en": "Image", "vi": "Hình ảnh", "ja": "画像" }, "input": "media" },
            { "column": "description", "label": { "en": "Description", "vi": "Mô tả", "ja": "説明" }, "input": "textarea" }
          ]
        },
        "permissions": { "read": "catalog:read", "write": "catalog:manage" }
      }
    ]
  }
}
