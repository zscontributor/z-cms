{
  "name": "@zcmsorg/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@zcmsorg/database": "workspace:*",
    "@zcmsorg/package": "workspace:*",
    "@zcmsorg/queue": "workspace:*",
    "@zcmsorg/scanner": "workspace:*",
    "@zcmsorg/theme-codegen": "workspace:*",
    "archiver": "7.0.1",
    "bullmq": "5.81.5",
    "dotenv": "18.0.9",
    "ioredis": "5.11.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/archiver": "6.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
