{
  "name": "@zcmsorg/plugin-runtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "verify:sandbox": "tsc -p tsconfig.build.json && node dist/verify-sandbox.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@zcmsorg/package": "workspace:*",
    "@zcmsorg/plugin-sdk": "workspace:*",
    "@zcmsorg/schemas": "workspace:*",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "isolated-vm": "7.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
