{
  "name": "@zcmsorg/cms-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:auth": "tsx test/verify-auth.ts",
    "verify:users": "tsx test/verify-users.ts",
    "verify:mfa": "tsx test/verify-mfa.ts",
    "openapi:json": "tsx src/openapi/generate.ts openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@zcmsorg/database": "workspace:*",
    "@zcmsorg/i18n": "workspace:*",
    "@zcmsorg/package": "workspace:*",
    "@zcmsorg/plugin-sdk": "workspace:*",
    "@zcmsorg/queue": "workspace:*",
    "@zcmsorg/scanner": "workspace:*",
    "@zcmsorg/schemas": "workspace:*",
    "bcryptjs": "3.0.3",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.5.0",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
